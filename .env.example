# Node runtime. For a local build use npm start with no .env file.
# To load a local copy explicitly use node --env-file=.env packages/backend/dist/index.js.
NODE_ENV=production
PORT=3000
CASHINGULARITY_BIND_HOST=127.0.0.1
CASHINGULARITY_DATA_DIR=/var/lib/cashingularity
CASHINGULARITY_TRUST_PROXY_IPS=127.0.0.1

# The isolated verification origin and the wallet origin must use different hostnames.
# The backend secret belongs in a server environment file. Leave empty until configured.
TURNSTILE_FRAME_PORT=3001
TURNSTILE_WALLET_ORIGINS=https://play.example.com
TURNSTILE_ALLOWED_HOSTNAMES=verify.example.com
TURNSTILE_SECRET_KEY=

# Leave development-only administration and the XO engine disabled on public deployments.
CASHINGULARITY_ADMIN_KEY=
CASHINGULARITY_XO_RPC_KEY=

ARCADE_TRUST_PROXY_IPS=127.0.0.1
ARCADE_ALLOWED_ORIGINS=https://play.example.com
ARCADE_WS_PATH=/ws/arcade/rocket-race
ARCADE_RECONNECT_MS=30000
ARCADE_MAX_CONNECTIONS=256
ARCADE_MAX_PER_IP=16
ARCADE_MAX_ROOMS=64

# Browser build-time values. Set these in packages/frontend/.env.local or export
# them before npm run build. The site key is public. The secret above is server-only.
# VITE_TURNSTILE_SITE_KEY=
# VITE_TURNSTILE_FRAME_ORIGIN=https://verify.example.com
# VITE_ARCADE_WS_URL=/ws/arcade/rocket-race
